#!/usr/bin/env bash
# kimi-slides wrapper — selects the bundled native binary for the current platform.
# Bundled platforms: linux-x64 only.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) PLATFORM="linux-x64" ;;
  *)
    echo "kimi-slides: unsupported platform $(uname -s)-$(uname -m)." >&2
    echo "This plugin bundles native binaries for linux-x64 only." >&2
    exit 1
    ;;
esac
exec "${SCRIPT_DIR}/native/${PLATFORM}/kimi-slides" "$@"
